    "test:pipeline": "tsx public-tests/turn-pipeline.ts",
    "test:deterministic-choices": "tsx public-tests/deterministic-choice-turns.ts",
    "test:domain": "tsx public-tests/domain-choice-availability.ts",
    "test:authority-shadow": "tsx public-tests/domain-authority-shadow.ts",
    "test:domain-continuity": "tsx public-tests/domain-thread-continuity.ts",
    "test:recovery-choice-priority": "tsx public-tests/recovery-choice-priority.ts",
    "test:active-thread": "tsx public-tests/active-thread-continuity.ts",
    "test:extended-continuity": "tsx public-tests/extended-continuity-matrix.ts",
    "test:choice-quality": "tsx public-tests/recommended-choice-quality.ts",
